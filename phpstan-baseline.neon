# Baseline de ÚLTIMO RECURSO: cada entrada aquí fue verificada a mano contra
# el esquema real (migraciones) y/o el comportamiento real de Laravel antes
# de aceptarla como falso positivo. No se usó para esconder errores reales,
# de hecho ninguno de estos es "software" incorrecto de esta app - son
# limitaciones conocidas de Larastan/PHPStan al analizar Eloquent/Fluent:
#
# 1) app/Http/Controllers/Audits/AuditItemController.php
#    $item->checked_by = $request->user()->id;
#    La columna checked_by es un FK nullable (int<0,max>|null, inferido del
#    esquema de audit_items). $request->user()->id se tipa como "int" llano
#    (no int<0,max>) porque el contrato Authenticatable no expone el tipo
#    preciso de la PK de users vía ese camino de inferencia. En tiempo de
#    ejecución el valor siempre es un id real y positivo; no hay forma de
#    "probárselo" a PHPStan sin castear/ignorar, algo que se pidió evitar.
#
# 2) app/Http/Controllers/Reports/ReportController.php (6 apariciones)
#    Company::find($id)?->name, Branch::find($id)?->name, etc.
#    Larastan reporta estas llamadas ::find() estáticas como "siempre no
#    nulas", lo cual es falso: find() SÍ devuelve null si el id (tomado de
#    un query string de filtros) ya no existe. Quitar el "?->" aquí
#    introduciría un bug real (acceso a propiedad sobre null). Se deja el
#    código como está a propósito.
#
# 3) app/Services/Responsibilities/AssetCharacteristicsBuilder.php
#    $asset->brand?->name — assets.brand_id es nullable en la migración
#    (un activo puede no tener marca capturada). Larastan tipa las
#    relaciones BelongsTo<Brand, $this> como siempre no nulas
#    (el genérico no expresa nulabilidad real de la FK), pero en este caso
#    SÍ puede ser null. Se deja el "?->" real y necesario. Aparece 2 veces:
#    una en buildComputerRows() y otra en buildGenericRows() (perfiles
#    "equipo de cómputo" vs. el resto), misma causa exacta en ambas.
#
# 4) database/migrations/..._create_company_document_settings_table.php
#    ->constrained(...)->name('cds_active_template_fk')
#    ForeignKeyDefinition extiende Illuminate\Support\Fluent, que resuelve
#    name() dinámicamente vía __call() (API pública y documentada de
#    Laravel para nombrar constraints manualmente, usada aquí porque el
#    nombre autogenerado excede el límite de 64 caracteres de MySQL).
#    Corre correctamente en runtime (migración verificada contra MySQL real);
#    Larastan simplemente no tiene un stub para este método mágico.
parameters:
	ignoreErrors:
		-
			message: '#^Property App\\Models\\AuditItem\:\:\$checked_by \(int\<0, max\>\|null\) does not accept int\.$#'
			identifier: assign.propertyType
			count: 1
			path: app/Http/Controllers/Audits/AuditItemController.php

		-
			message: '#^Using nullsafe property access "\?\-\>full_name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Reports/ReportController.php

		-
			message: '#^Using nullsafe property access "\?\-\>name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 5
			path: app/Http/Controllers/Reports/ReportController.php

		-
			message: '#^Using nullsafe property access "\?\-\>name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: app/Services/Responsibilities/AssetCharacteristicsBuilder.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Schema\\ForeignKeyDefinition\:\:name\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: database/migrations/2026_08_26_090400_create_company_document_settings_table.php
